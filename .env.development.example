# Copy to .env.development.local after `supabase start` and replace the key
# with the local publishable/anon key printed by the local Supabase CLI.
# This template is only for `next dev`; do not use a hosted project URL here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key

# Optional local-only AI provider settings. Keep private keys server-only.
# OPENAI_API_KEY=
# OPENAI_MODEL=
