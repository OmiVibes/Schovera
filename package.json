{
  "name": "schovera",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts --no-cache --concurrency 1",
    "typecheck": "tsc --noEmit",
    "test": "npm run verify:phase1",
    "test:watch": "vitest",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "clean:demo": "node --env-file=.env.local scripts/clean-demo-data.mjs",
    "verify:phase1": "node --env-file=.env.local scripts/verify-phase1.mjs",
    "verify:attendance": "node --env-file=.env.local scripts/verify-attendance.mjs",
    "verify:announcements": "node --env-file=.env.local scripts/verify-announcements.mjs",
    "verify:corrections": "node --env-file=.env.local scripts/verify-corrections.mjs",
    "verify:assignments": "node --env-file=.env.local scripts/verify-assignments.mjs",
    "verify:idempotency": "node --env-file=.env.local scripts/verify-idempotency.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "react-hook-form": "^7.66.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "vitest": "^3.2.4"
  }
}
